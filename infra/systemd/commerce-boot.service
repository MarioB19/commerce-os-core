[Unit]
Description=Commerce OS V7 durable boot: start the installed release after the VM starts (never sessions, never data)
After=docker.service containerd.service network-online.target
Requires=docker.service
Wants=network-online.target
ConditionPathExists=/opt/commerce-os/private/boot/operator.json
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I /opt/commerce-os/current/scripts/v7_boot.py run /opt/commerce-os/private/boot/operator.json
TimeoutStartSec=35min
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
