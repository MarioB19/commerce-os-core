[Unit]
Description=Commerce OS bounded gateway supervisor (capacity, spare slot, crash restart; never starts sessions)
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/commerce-os/gateway-supervisor.json
[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /opt/commerce-os/current/scripts/gateway_supervisor.py /etc/commerce-os/gateway-supervisor.json run
Restart=on-failure
RestartSec=30
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
