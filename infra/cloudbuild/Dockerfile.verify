# Build once from a reviewed checkout; triggers must use its immutable digest.
# The candidate PR must not build or replace this trusted runner image.
FROM docker:29.9.0-cli@sha256:1a4c7cb63513f349bdad01fcc6e0f3f2f67d37b9da86f14dc0d4a0942eecda00 AS docker_cli
FROM node:24.20.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 git ca-certificates curl openssl procps tar gzip libpcre2-8-0 \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.42-1+deb12u2' \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@10.34.5 \
    && npx --yes playwright@1.63.0 install-deps chromium
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/
COPY scripts/cloudbuild-verify.py /opt/commerce-ci/cloudbuild-verify.py
# Custody fixtures create temporary directories below this unmounted home.
RUN chmod 0700 /root \
    && node --version && pnpm --version && python3 --version && docker --version && docker compose version
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
ENTRYPOINT ["python3", "/opt/commerce-ci/cloudbuild-verify.py"]
