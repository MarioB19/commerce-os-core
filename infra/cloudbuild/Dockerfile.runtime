# syntax=docker/dockerfile:1.7.1@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Build context is created by the protected installation operator. Its config
# contains reviewed native resource IDs/generations, never credentials. Build a
# separate immutable image for each controller/attestor role; do not use env vars
# or a mutable file mount to select runtime identity/custody.
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/commerce PATH=/usr/bin:/bin LC_ALL=C.UTF-8
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends python3 git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/trusted /home/commerce \
    && chown 65532:65532 /home/commerce && chmod 0700 /home/commerce
COPY scripts/cloudbuild_*.py scripts/cloudbuild-http.py scripts/cloudbuild-attest.py /opt/trusted/
COPY scripts/ci_release.py scripts/ci_provider_evidence.py scripts/ephemeral_os_login.py scripts/operator_identity.py /opt/trusted/
COPY runtime-config.json /opt/trusted/runtime-config.json
RUN chmod 0444 /opt/trusted/* && chmod 0755 /opt/trusted \
    && python3 -I -c 'import sys; sys.path.insert(0,"/opt/trusted"); from cloudbuild_runtime import read_installed_config; read_installed_config(); import cloudbuild_runtime_release, cloudbuild_publisher_worker'
USER 65532:65532
WORKDIR /home/commerce
EXPOSE 8080
ENTRYPOINT ["/usr/bin/python3", "-I", "/opt/trusted/cloudbuild-http.py"]
