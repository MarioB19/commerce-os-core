# Códigos permitidos convertidos previamente a SHA-256 (hex), separados por coma.
# Nunca pongas los códigos en texto plano ni uses ejemplos reales en este archivo.
MCL_CORE_CODES_SHA256=hash_sha256_del_codigo_core
MCL_KIT_CODES_SHA256=hash_sha256_del_codigo_kit

# Secreto aleatorio de 32 bytes o más para firmar sesiones HMAC.
# Genera uno exclusivo con `openssl rand -hex 32`; no copies un valor de ejemplo.
MCL_SESSION_SECRET=

# Origen canónico cuando exista dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo existente y verificado; independiente de los futuros números de Ventas.
MCL_SUPPORT_EMAIL=
# Datos reales del responsable del tratamiento. Sólo servidor, nunca códigos aquí.
MCL_PRIVACY_NAME=
MCL_PRIVACY_ADDRESS=
MCL_PRIVACY_EMAIL=

# Directorio privado persistente, escribible únicamente por el portal.
MCL_ACCESS_DB=/data/access-attempts.sqlite
