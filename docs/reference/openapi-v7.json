  "/v1/settings/operations": {
   "get": {
    "responses": {
     "200": {
      "description": "Default Response"
     }
    },
    "summary": "Read current operational policy (human owner only)",
    "tags": [
     "Settings"
    ]
   },
   "patch": {
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "additionalProperties": false,
        "properties": {
         "changes": {
          "additionalProperties": false,
          "properties": {
           "allow_channel_onboarding": {
            "type": "boolean"
           },
           "allow_real_operations": {
            "type": "boolean"
           },
           "channel_account_concurrency": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
           },
           "contact_messages_per_minute": {
            "maximum": 60,
            "minimum": 1,
            "type": "integer"
           },
           "dispatch_frozen": {
            "type": "boolean"
           },
           "real_sends_enabled": {
            "type": "boolean"
           }
          },
          "type": "object"
         },
         "environment": {
          "enum": [
           "REAL",
           "SIMULATION"
          ],
          "type": "string"
         },
         "expected_version": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "reason": {
          "maxLength": 2000,
          "minLength": 3,
          "type": "string"
         }
        },
        "required": [
         "expected_version",
         "reason",
         "changes"
        ],
        "type": "object"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Default Response"
     }
    },
    "summary": "Update operational policy and invalidate earlier authorizations",
    "tags": [
     "Settings"
    ]
   }
  },
