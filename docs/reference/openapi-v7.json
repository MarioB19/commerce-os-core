    "description": "Public, non-sensitive deployment readback. It grants no operational authority.",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": false,
         "properties": {
          "configured": {
           "type": "boolean"
          },
          "release": {
           "type": "string"
          },
          "service": {
           "enum": [
            "commerce-api"
           ],
           "type": "string"
          },
          "sha": {
           "anyOf": [
            {
             "pattern": "^[a-f0-9]{40}$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "service",
          "release",
          "sha",
          "configured"
         ],
         "type": "object"
        }
       }
      },
      "description": "Default Response"
     }
    },
